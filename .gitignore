# build outputs and local state (never commit)
build/
site/
# ...but not the test fixture of worker-intel (a saved copy of live pages its tests read)
!/worker-intel/test/fixtures/site/
node_modules/
.wrangler/
__pycache__/
*.pyc
*.tmp~
serve.pid
*.zip
# secrets and local env files — keep them in Cloudflare / GitHub secrets, never here
.env
.env.*
.dev.vars
*.pem
*.key
deploy-secrets/
# database exports hold member data — never commit
*d1-backup*.sql
