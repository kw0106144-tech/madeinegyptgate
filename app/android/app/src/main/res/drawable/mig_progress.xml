<?xml version="1.0" encoding="utf-8"?>
<!-- The load bar over the page (MigChromeClient.showProgress): the site's red on the page, nothing behind it. Used by
     layout/capacitor_bridge_layout_main.xml, which overrides Capacitor's layout (lint cannot see that it is used). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UnusedResources">
    <item android:id="@android:id/background">
        <color android:color="@android:color/transparent" />
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/mig_red" />
            </shape>
        </clip>
    </item>
</layer-list>
