<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- The theme while the site is shown. windowBackground is the colour behind the status bar and the navigation bar
         (MainActivity.keepWebViewBetweenBars pads the WebView by the bars; Capacitor's SystemBars sets it on the window): the
         site's top bar / footer red. Light bar icons on it come from plugins.SystemBars.style / plugins.StatusBar.style = DARK in
         capacitor.config.json. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/mig_red_deep</item>
        <item name="android:statusBarColor">@color/mig_red_deep</item>
        <item name="android:navigationBarColor">@color/mig_red_deep</item>
        <item name="colorPrimary">@color/mig_red_deep</item>
        <item name="colorPrimaryDark">@color/mig_red_deep</item>
        <item name="colorAccent">@color/mig_red</item>
    </style>

    <!-- Launch: the SplashScreen API (androidx core-splashscreen, also used below Android 12) with the brand red and the badge;
         @drawable/splash is the legacy full-screen image of the splash-screen plugin. Images: app/tools/make_assets.py -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/mig_red_deep</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:background">@drawable/splash</item>
    </style>

    <!-- A page window over the page (MigWindows): full screen, the brand red behind the bars and the page window's own red bar,
         opening like a new screen. -->
    <style name="MigWindow" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/mig_red_deep</item>
        <item name="android:statusBarColor">@color/mig_red_deep</item>
        <item name="android:navigationBarColor">@color/mig_red_deep</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Activity</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="colorPrimary">@color/mig_red_deep</item>
        <item name="colorAccent">@color/mig_red</item>
    </style>
</resources>
