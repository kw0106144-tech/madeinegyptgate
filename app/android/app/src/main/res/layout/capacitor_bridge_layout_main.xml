<?xml version="1.0" encoding="utf-8"?>
<!-- Overrides Capacitor's own layout of the same name (node_modules/@capacitor/android/capacitor/src/main/res/layout/
     capacitor_bridge_layout_main.xml, read by BridgeActivity.onCreate): the same WebView (class and id "webview", which Bridge
     looks up), inside the app's pull to reload (MigPullLayout) and under a thin load bar (mig_progress, MigChromeClient).
     After a Capacitor upgrade compare it with Capacitor's file (app/README.md "Upgrading Capacitor"). -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mig_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.madeinegyptgate.app.MainActivity"
    tools:ignore="UnusedResources">

    <com.madeinegyptgate.app.MigPullLayout
        android:id="@+id/mig_pull"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.getcapacitor.CapacitorWebView
            android:id="@+id/webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </com.madeinegyptgate.app.MigPullLayout>

    <ProgressBar
        android:id="@+id/mig_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="top"
        android:importantForAccessibility="no"
        android:max="100"
        android:maxHeight="3dp"
        android:minHeight="3dp"
        android:progressDrawable="@drawable/mig_progress"
        android:visibility="gone" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
