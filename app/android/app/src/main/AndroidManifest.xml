<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Backups (android-backup-rules): Android may back the app up and restore it on a new phone, but never the WebView's data
         (localStorage with the member's sign-in token, cookies) nor the old system's session id: res/xml/data_extraction_rules.xml
         (Android 12+) and res/xml/backup_rules.xml (older). A restored phone starts signed out, as Chrome does. -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Android App Links: a tap on https://madeinegyptgate.com/… (mail, WhatsApp, search) opens that page in the app.
                 Android verifies the host against https://madeinegyptgate.com/.well-known/assetlinks.json, which must list the
                 SHA-256 of the app signing key (template: app/well-known/assetlinks.json). Until the site serves it, links keep
                 opening in the browser. www is left out on purpose: it redirects to the apex, the verifier does not follow
                 redirects, and before Android 12 one failing host disables App Links for all hosts of the filter. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="madeinegyptgate.com" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- The app's side of the site ↔ app association for saved passwords (the old-account form of /login/): Google's credential
             sharing reads this from the app AND /.well-known/assetlinks.json (get_login_creds) from the site. Google picks it up only
             for the app published on Google Play's public channel, not for the APK of /app/ (app/well-known/README.md). -->
        <meta-data
            android:name="asset_statements"
            android:resource="@string/asset_statements" />
    </application>

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- live video calls with Janna / Bassem (WebRTC getUserMedia in the WebView, asked when a call starts) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Android 7–11: the live calls use Bluetooth earbuds / headsets for the voice and the microphone, as Chrome does (the WebView's
         audio code lists a Bluetooth headset only when the app holds this; install-time, no prompt; Android 12+ needs none) -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <!-- push notifications (Android 13+ asks only when the app registers: off until Firebase is set up, app/README.md) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- camera and microphone are optional: phones and tablets without them can still install the app from Google Play -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

    <!-- Android 11+: lets the file chooser of the WebView find the camera app (<input type=file capture>, and the camera next to the
         gallery in MigChromeClient's chooser), and the WebView's speech recognition (Web Speech: the 🎤 of Janna's chat) find the
         phone's recognition service -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.media.action.VIDEO_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>
</manifest>
