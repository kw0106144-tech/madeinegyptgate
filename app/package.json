{
  "name": "madeinegyptgate-app",
  "version": "1.0.0",
  "private": true,
  "description": "Native iOS and Android apps of madeinegyptgate.com (Capacitor). The app shows the live site, so every site change is in the app at once.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "sync": "cap sync",
    "check": "node tools/check-app.mjs",
    "assets": "python3 tools/make_assets.py",
    "android:debug": "cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.6.2",
    "@capacitor/ios": "8.6.2",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/network": "8.0.1",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2"
  }
}
